# Jatayu VTOL QuadPlane ArduPilot SITL Parameters
# Airframe: Standard QuadPlane (4 multirotor lift motors + 1 forward pusher)

# VTOL Enable & Frame Type
Q_ENABLE        1
Q_FRAME_CLASS   1
Q_FRAME_TYPE    1

# Transition Dynamics
Q_TRANS_SPEED   16.0
Q_ASSIST_SPEED  13.0
Q_TRANSITION_MS 5000
Q_RTL_MODE      1
Q_LAND_FINAL_ALT 5.0

# Multirotor PID Gains
Q_A_RAT_RLL_P   0.25
Q_A_RAT_RLL_I   0.25
Q_A_RAT_RLL_D   0.005
Q_A_RAT_PIT_P   0.25
Q_A_RAT_PIT_I   0.25
Q_A_RAT_PIT_D   0.005
Q_A_RAT_YAW_P   0.35
Q_A_RAT_YAW_I   0.035

# Fixed Wing Cruise Parameters
ARSPD_FBW_MIN   12.0
ARSPD_FBW_MAX   26.0
TRIM_ARSPD_CM   1800
AIRSPEED_CRUISE 18.0

# Payload Servo Setup (Channel 11 - Gripper / Drop)
SERVO11_FUNCTION 28
SERVO11_MIN      1000
SERVO11_MAX      2000
SERVO11_TRIM     1000
GRIP_ENABLE      1
GRIP_TYPE        1
